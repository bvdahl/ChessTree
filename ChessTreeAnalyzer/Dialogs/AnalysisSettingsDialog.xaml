<Window x:Class="ChessTreeAnalyzer.Dialogs.AnalysisSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analysis Settings" 
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Chess Analysis Settings" FontSize="18" FontWeight="Bold" 
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <!-- Settings Panel -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- Engine Settings -->
                <GroupBox Header="Engine Settings" Margin="0,0,0,15" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Stockfish Path -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Stockfish Path:" VerticalAlignment="Center"/>
                        <TextBox x:Name="StockfishPathTextBox" Grid.Row="0" Grid.Column="1" Margin="5" Height="25"/>
                        <Button x:Name="BrowseStockfishButton" Grid.Row="0" Grid.Column="2" 
                                Content="Browse..." Width="80" Height="25" Margin="5,0,0,0" Click="BrowseStockfish_Click"/>

                        <!-- Hash Size -->
                        <Label Grid.Row="1" Grid.Column="0" Content="Hash Size (MB):" VerticalAlignment="Center"/>
                        <TextBox x:Name="HashSizeTextBox" Grid.Row="1" Grid.Column="1" Text="1024" Margin="5" Height="25"/>

                        <!-- Thread Count -->
                        <Label Grid.Row="2" Grid.Column="0" Content="Thread Count:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ThreadCountTextBox" Grid.Row="2" Grid.Column="1" Text="4" Margin="5" Height="25"/>

                        <!-- Analysis Time -->
                        <Label Grid.Row="3" Grid.Column="0" Content="Time per Position (s):" VerticalAlignment="Center"/>
                        <TextBox x:Name="AnalysisTimeTextBox" Grid.Row="3" Grid.Column="1" Text="1.0" Margin="5" Height="25"/>
                    </Grid>
                </GroupBox>

                <!-- Analysis Depth -->
                <GroupBox Header="Analysis Parameters" Margin="0,0,0,15" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Maximum Depth:" VerticalAlignment="Center"/>
                        <Slider x:Name="MaxDepthSlider" Grid.Row="0" Grid.Column="1" 
                                Minimum="1" Maximum="8" Value="3" 
                                TickPlacement="BottomRight" TickFrequency="1" 
                                IsSnapToTickEnabled="True" Margin="5"
                                ValueChanged="MaxDepthSlider_ValueChanged"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DepthValueText" 
                                   Text="Depth: 3" Margin="5,0,0,0" FontSize="12" Foreground="Gray"/>
                    </Grid>
                </GroupBox>

                <!-- Move Analysis Settings -->
                <GroupBox Header="Move Analysis" Margin="0,0,0,15" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- White Settings -->
                        <Label Grid.Row="0" Grid.Column="0" Content="White Moves:" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="5">
                            <TextBox x:Name="WhiteMovesTextBox" Text="3" Width="50" Height="25"/>
                            <Label Content="moves, threshold:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <TextBox x:Name="WhiteThresholdTextBox" Text="50" Width="50" Height="25"/>
                            <Label Content="cp" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>

                        <!-- Black Settings -->
                        <Label Grid.Row="1" Grid.Column="0" Content="Black Moves:" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="5">
                            <TextBox x:Name="BlackMovesTextBox" Text="3" Width="50" Height="25"/>
                            <Label Content="moves, threshold:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <TextBox x:Name="BlackThresholdTextBox" Text="50" Width="50" Height="25"/>
                            <Label Content="cp" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Output Settings -->
                <GroupBox Header="Output Options" Margin="0,0,0,15" Padding="10">
                    <StackPanel>
                        <CheckBox x:Name="SavePGNCheckBox" Content="Save analysis as PGN" IsChecked="True" Margin="0,5"/>
                        <CheckBox x:Name="SaveJSONCheckBox" Content="Save analysis as JSON" IsChecked="False" Margin="0,5"/>
                        <CheckBox x:Name="VerboseOutputCheckBox" Content="Verbose console output" IsChecked="True" Margin="0,5"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="LoadPresetButton" Content="Load Preset..." Width="100" Height="30" 
                    Margin="0,0,10,0" Click="LoadPreset_Click"/>
            <Button x:Name="SavePresetButton" Content="Save Preset..." Width="100" Height="30" 
                    Margin="0,0,10,0" Click="SavePreset_Click"/>
            <Button x:Name="OkButton" Content="OK" Width="80" Height="30" 
                    Margin="0,0,10,0" IsDefault="True" Click="Ok_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" 
                    IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>