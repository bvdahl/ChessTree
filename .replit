modules = ["python-3.11", "dotnet-8.0"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Chess Tree Generator Setup"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "chess_tree_test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Chess GUI Launcher"

[[workflows.workflow]]
name = "Chess Tree Generator Setup"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install python-chess psutil && echo \"Dependencies installed successfully. Ready to run chess tree generator.\""

[[workflows.workflow]]
name = "chess_tree_test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install python-chess psutil && wget -O stockfish https://github.com/official-stockfish/Stockfish/releases/latest/download/stockfish-ubuntu-x86-64-avx2.tar && tar -xf stockfish-ubuntu-x86-64-avx2.tar && mv stockfish*/stockfish . && chmod +x stockfish && python chess_tree_generator.py --fen \"rnbqkbnr/pppppppp/8/8/4P3/8/PPPP1PPP/RNBQKBNR b KQkq e3 0 1\" --stockfish-path ./stockfish --depth 2 --time 0.5"

[[workflows.workflow]]
name = "Chess GUI Launcher"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python run_gui.py"

[deployment]
deploymentTarget = "cloudrun"
