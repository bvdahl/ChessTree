<Window x:Class="ChessTreeAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ChessTreeAnalyzer.Views"
        Title="Chess Tree Analyzer" 
        Height="800" Width="1200"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Menu -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="#F5F5F5" Padding="5">
            <MenuItem Header="_File">
                <MenuItem Header="_Open PGN..." Click="OpenPGN_Click" InputGestureText="Ctrl+O"/>
                <!-- FEN loading removed per user request -->
                <Separator/>
                <MenuItem Header="_Save Analysis..." Click="SaveAnalysis_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Click="SaveAsAnalysis_Click" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Analysis">
                <MenuItem Header="_Start Analysis" Click="StartAnalysis_Click" InputGestureText="F5"/>
                <MenuItem Header="S_top Analysis" Click="StopAnalysis_Click" InputGestureText="F6"/>
                <Separator/>
                <MenuItem Header="_Settings..." Click="AnalysisSettings_Click" InputGestureText="F7"/>
                <MenuItem Header="_Engine Settings..." Click="EngineSettings_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Show _Board" IsCheckable="True" IsChecked="True" Click="ToggleBoard_Click"/>
                <MenuItem Header="Show _Analysis Tree" IsCheckable="True" IsChecked="True" Click="ToggleAnalysisTree_Click"/>
                <MenuItem Header="Show _Output" IsCheckable="True" IsChecked="True" Click="ToggleOutput_Click"/>
                <Separator/>
                <MenuItem Header="_Reset Layout" Click="ResetLayout_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
                <MenuItem Header="_User Guide" Click="UserGuide_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1" Background="#F0F0F0" Padding="5">
            <Button Name="OpenPGNButton" Click="OpenPGN_Click" ToolTip="Open PGN File (Ctrl+O)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Open PGN"/>
                </StackPanel>
            </Button>
            <!-- FEN loading button removed per user request -->
            <Separator/>
            <Button Name="StartAnalysisButton" Click="StartAnalysis_Click" ToolTip="Start Analysis (F5)" Background="#4CAF50" Foreground="White">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▶" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Start Analysis"/>
                </StackPanel>
            </Button>
            <Button Name="StopAnalysisButton" Click="StopAnalysis_Click" ToolTip="Stop Analysis (F6)" Background="#F44336" Foreground="White" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏹" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Stop"/>
                </StackPanel>
            </Button>
            <Separator/>
            <TextBlock Text="Depth:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox Name="DepthTextBox" Text="3" Width="40" VerticalAlignment="Center"/>
            <TextBlock Text="Time (s):" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox Name="TimeTextBox" Text="60" Width="50" VerticalAlignment="Center"/>
        </ToolBar>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300"/> <!-- Chess Board -->
                <ColumnDefinition Width="5"/>                  <!-- Splitter -->
                <ColumnDefinition Width="3*" MinWidth="400"/>  <!-- Analysis Panel -->
            </Grid.ColumnDefinitions>

            <!-- Chess Board Panel -->
            <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="1" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Chess Board" FontWeight="Bold" FontSize="16" 
                              Margin="10" HorizontalAlignment="Center"/>
                    
                    <!-- Chess Board will go here -->
                    <views:ChessBoardView x:Name="ChessBoard" Grid.Row="1" Margin="10"/>
                    
                    <!-- Board Controls -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                        <Button Content="◀◀" ToolTip="First Position" Margin="2"/>
                        <Button Content="◀" ToolTip="Previous Move" Margin="2"/>
                        <Button Content="▶" ToolTip="Next Move" Margin="2"/>
                        <Button Content="▶▶" ToolTip="Last Position" Margin="2"/>
                        <Separator Margin="10,0"/>
                        <Button Content="Flip Board" Margin="2"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" Background="#DDD" HorizontalAlignment="Stretch"/>

            <!-- Analysis Panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>   <!-- Analysis Tree -->
                    <RowDefinition Height="5"/>   <!-- Splitter -->
                    <RowDefinition Height="200"/> <!-- Output Log -->
                </Grid.RowDefinitions>

                <!-- Analysis Tree -->
                <Border Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="1" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="Analysis Tree" FontWeight="Bold" FontSize="16" 
                                  Margin="10" HorizontalAlignment="Center"/>
                        
                        <TreeView x:Name="AnalysisTreeView" Grid.Row="1" Margin="10">
                            <!-- Analysis tree items will be populated here -->
                        </TreeView>
                    </Grid>
                </Border>

                <!-- Vertical Splitter -->
                <GridSplitter Grid.Row="1" Height="5" Background="#DDD" VerticalAlignment="Stretch"/>

                <!-- Output Log -->
                <Border Grid.Row="2" Background="White" BorderBrush="#DDD" BorderThickness="1" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                            <TextBlock Text="Analysis Output" FontWeight="Bold" FontSize="16"/>
                            <Button x:Name="CopyOutputButton" Content="Copy to Clipboard" 
                                    Margin="15,0,0,0" Height="25" Click="CopyOutput_Click"/>
                            <Button x:Name="SaveOutputButton" Content="Save to File" 
                                    Margin="5,0,0,0" Height="25" Click="SaveOutput_Click"/>
                        </StackPanel>
                        
                        <ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="OutputTextBox" FontFamily="Consolas" FontSize="12" 
                                    TextWrapping="Wrap" Background="#F8F8F8" Padding="5" 
                                    IsReadOnly="True" AcceptsReturn="True"
                                    VerticalScrollBarVisibility="Auto"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#F5F5F5" Height="25">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ProgressText" Text="" Margin="0,0,10,0"/>
                    <ProgressBar x:Name="AnalysisProgressBar" Width="150" Height="16" 
                                Value="0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>