{
  "name": "chess-tree-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "bridge": "node server/engine-bridge.js",
    "dev:full": "concurrently -n app,bridge -c green,cyan \"vite\" \"node server/engine-bridge.js\"",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n app,electron -c green,magenta \"vite\" \"cross-env ELECTRON_DEV_URL=http://localhost:5000 electron .\"",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "chess.js": "^1.0.0-beta.8",
    "concurrently": "^9.2.1",
    "react": "^18.3.1",
    "react-chessboard": "^4.7.2",
    "react-dom": "^18.3.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "stockfish": "^16.0.0",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.chesstree.analyzer",
    "productName": "Chess Tree Analyzer",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/uciProcess.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
